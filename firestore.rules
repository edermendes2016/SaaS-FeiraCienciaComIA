rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPER FUNCTIONS ───────────────────────────────────────────
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isProjectMember(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return isAuthenticated() && (
        project.ownerId == request.auth.uid ||
        (project.members != null && project.members[request.auth.uid] != null && project.members[request.auth.uid].status == 'accepted') ||
        (project.collaborators != null && project.collaborators[request.auth.uid] == true)
      );
    }

    // ── USERS COLLECTION ───────────────────────────────────────────
    
    match /users/{userId} {
      // Segurança e Economia: Só o próprio usuário pode ler e escrever seus dados
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ── INVITES COLLECTION ─────────────────────────────────────────
    
    match /invites/{inviteId} {
      // Evita spam: O remetente deve ser o usuário logado
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      
      allow read: if isAuthenticated() && (
        request.auth.token.email != null && 
        resource.data.receiverEmail.lower() == request.auth.token.email.lower() || 
        resource.data.senderId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        request.auth.token.email != null && 
        resource.data.receiverEmail.lower() == request.auth.token.email.lower() || 
        resource.data.senderId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        request.auth.token.email != null && 
        resource.data.receiverEmail.lower() == request.auth.token.email.lower() || 
        resource.data.senderId == request.auth.uid
      );
    }

    // ── PROJECTS COLLECTION ────────────────────────────────────────
    
    match /projects/{projectId} {
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || 
        (resource.data.members != null && resource.data.members[request.auth.uid] != null && resource.data.members[request.auth.uid].status == 'accepted') ||
        (resource.data.collaborators != null && resource.data.collaborators[request.auth.uid] == true)
      );
      
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || 
        (resource.data.members != null && resource.data.members[request.auth.uid] != null && resource.data.members[request.auth.uid].status == 'accepted') ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collaborators', 'updatedAt', 'members', 'executionProtocol', 'reportDraft', 'currentStep', 'explanation'])
      );
      
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // Chat Messages
      match /messages/{messageId} {
        allow read: if isProjectMember(projectId);
        allow create: if isProjectMember(projectId) && request.resource.data.senderId == request.auth.uid;
        allow delete: if isProjectMember(projectId) && (
          resource.data.senderId == request.auth.uid || 
          (get(/databases/$(database)/documents/projects/$(projectId)).data.members != null && 
           get(/databases/$(database)/documents/projects/$(projectId)).data.members[request.auth.uid] != null &&
           get(/databases/$(database)/documents/projects/$(projectId)).data.members[request.auth.uid].role == 'teacher')
        );
      }

      match /{allSubcollections=**} {
        allow read, write: if isProjectMember(projectId);
      }
    }

    match /teacher_requests/{requestId} {
      // Segurança: Apenas o próprio usuário pode criar seu pedido e ninguém pode ler via front
      allow create: if isAuthenticated() && request.resource.data.email == request.auth.token.email;
      allow read: if false; 
    }
  }
}
